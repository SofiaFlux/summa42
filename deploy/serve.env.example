# /etc/summa42/serve.env: settings of deploy/summa42-serve.sh.
# No secrets here. The GitHub token lives in its own private file.

# Collective home of the Box user (where `summa42 init` ran).
SUMMA42_HOME=/home/summa42/.summa42

# From `summa42 mission show` and `summa42 envelope list`.
SUMMA42_MISSION=mission_replace_me
SUMMA42_ENVELOPE=summa42-work

# The repository and who may open issues for it.
SUMMA42_GITHUB_REPOSITORY=owner/name
SUMMA42_MAINTAINER=owner-login
SUMMA42_BASE_BRANCH=main
# Private token file, mode 0600, owned by the Box user.
SUMMA42_GITHUB_TOKEN_FILE=/home/summa42/.summa42/github_token
# Only issues with this label may be implemented. Leave empty to plan only.
SUMMA42_AUTO_GRANT_LABEL=summa-auto
# The login whose comments must not count as a new issue revision (optional).
SUMMA42_BOT_LOGIN=

# A local clone of the repository, kept up to date by the Owner, and a
# directory outside it for attempt workspaces. Absolute paths.
SUMMA42_SOURCE_REPO=/srv/summa42/source/name
SUMMA42_WORKSPACE_ROOT=/srv/summa42/attempts
# Directory the pipeline may change files in, ending in "/".
SUMMA42_ALLOWED_PREFIX=internal/
# What validates a candidate, as a JSON argument array.
SUMMA42_VALIDATION_COMMAND_JSON=["go","test","./...","-count=1"]

# The dedicated OS users from scripts/setup-model-user.sh.
SUMMA42_MODEL_USER=summa42-model
SUMMA42_VALIDATION_USER=summa42-validate
# A Go toolchain the validation user can run.
SUMMA42_VALIDATION_TOOLCHAIN_DIRS=/usr/local/go/bin

# Producer and reviewer must be different models.
SUMMA42_PRODUCER_PROFILE=agy
SUMMA42_PRODUCER_MODEL=replace-with-the-producer-model-id
SUMMA42_REVIEWER_PROFILE=claude
SUMMA42_REVIEWER_MODEL=replace-with-the-reviewer-model-id
# agy cuts prompts over 110000 bytes; keep the planner context under it.
SUMMA42_CONTEXT_MAX_BYTES=80000

# Optional: a private file (mode 0600) holding a Discord webhook address.
# When set, the Owner is told when an approval waits, a case is held, a pull
# request is ready, the Collective is frozen or near safe mode, or a budget is
# 80 percent used. Messages carry identifiers only.
SUMMA42_DISCORD_WEBHOOK_FILE=

# Where the binaries are, when not on PATH.
SUMMA42_BOX_BIN=/usr/local/bin/summa42-box
